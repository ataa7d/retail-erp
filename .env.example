DATABASE_URL=postgres://erp:erp_dev_password@localhost:5432/retail_erp
JWT_SECRET=change-me-in-production
PORT=3000
HOST=0.0.0.0
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts ZATCA e-invoicing onboarding secrets (EGS private key, compliance/production CSID secrets) at rest.
ZATCA_CREDENTIAL_KEY=

# Web Push (browser notifications). Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Email (SMTP) -- notifications log and skip silently until these are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
